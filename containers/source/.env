COMPOSE_PROJECT_NAME=electricpeak

## Global Settings
# Keep the deployment's personal home path out of the public repository.
# Existing deployments should migrate or bind this directory before switching.
DOCKERCONFDIR=/var/lib/electricpeak/appdata
DOCKERSTORAGEDIR=/mnt/data
PUID=1000
PGID=100
# <change to your timezone>
TZ=America/Los_Angeles
# Dockerlogging and max size
DOCKERLOGGING_MAXFILE=10
DOCKERLOGGING_MAXSIZE=200k
